<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>/*
 * Four vikings are about to cross a damaged bridge in the middle of the
 * night. The bridge can only carry two of the vikings at the time and to
 * find the way over the bridge the vikings need to bring a torch.  The
 * vikings need 5, 10, 20 and 25 minutes (one-way) respectively to cross
 * the bridge.

 * Does a schedule exist which gets all four vikings over the bridge
 * within 60 minutes?
 */

chan take, release0, release1;		// Take and release torch
int[0,1] L;		// The side the torch is on
int[0,1] B;  // Choice of bridge, enforces delays correspondingly
clock time;		// Global time
</declaration>
	<template>
		<name x="32" y="16">Soldier</name>
		<parameter>const int delay</parameter>
		<declaration>clock y;</declaration>
		<location id="id0" x="289" y="76">
		</location>
		<location id="id1" x="288" y="216">
			<name x="272" y="232">safe</name>
		</location>
		<location id="id2" x="64" y="216">
		</location>
		<location id="id3" x="59" y="76">
			<name x="51" y="44">unsafe</name>
		</location>
		<branchpoint id="id4" x="289" y="76"/>
		<branchpoint id="id5" x="289" y="76"/>
		<init ref="id3"/>
		<transition id="id6">
			<source ref="id2"/>
			<target ref="id2"/>
			<label kind="assignment" x="76" y="314">B = 1 - B</label>
			<nail x="17" y="297"/>
			<nail x="102" y="306"/>
		</transition>
		<transition id="id7">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="-195" y="119">y &gt;= delay*2
   &amp;&amp; B == 1</label>
			<label kind="synchronisation" x="-161" y="161">release1!</label>
			<nail x="-77" y="195"/>
			<nail x="-77" y="102"/>
		</transition>
		<transition id="id8">
			<source ref="id0"/>
			<target ref="id0"/>
			<label kind="assignment" x="331" y="-42">B = 1 - B</label>
			<nail x="289" y="-25"/>
			<nail x="365" y="0"/>
		</transition>
		<transition id="id9">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="450" y="119">y &gt;= delay*2 &amp;&amp;
B == 1</label>
			<label kind="synchronisation" x="450" y="161">release1!</label>
			<nail x="433" y="93"/>
			<nail x="433" y="195"/>
		</transition>
		<transition id="id10">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="76" y="119">y &gt;= delay &amp;&amp;
B == 0</label>
			<label kind="synchronisation" x="76" y="161">release0!</label>
		</transition>
		<transition id="id11">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="208" y="224">L == 1</label>
			<label kind="synchronisation" x="216" y="192">take !</label>
			<label kind="assignment" x="104" y="224">y = 0</label>
		</transition>
		<transition id="id12">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="297" y="119">y &gt;= delay &amp;&amp;
B == 0</label>
			<label kind="synchronisation" x="297" y="161">release0!</label>
		</transition>
		<transition id="id13">
			<source ref="id3"/>
			<target ref="id0"/>
			<label kind="guard" x="161" y="17">L == 0</label>
			<label kind="synchronisation" x="153" y="51">take !</label>
			<label kind="assignment" x="161" y="34">y = 0</label>
		</transition>
	</template>
	<template>
		<name x="32" y="-16">Torch</name>
		<location id="id14" x="204" y="144">
			<name x="199" y="164">viking1</name>
		</location>
		<location id="id15" x="204" y="17">
			<name x="136" y="-25">viking1or2or3</name>
			<urgent/>
		</location>
		<location id="id16" x="25" y="102">
			<name x="9" y="70">free</name>
		</location>
		<location id="id17" x="357" y="68">
			<name x="366" y="85">two</name>
		</location>
		<location id="id18" x="382" y="-68">
			<name x="348" y="-110">viking2or3</name>
			<urgent/>
		</location>
		<location id="id19" x="535" y="25">
			<name x="578" y="-25">three</name>
		</location>
		<location id="id20" x="535" y="110">
		</location>
		<location id="id21" x="476" y="187">
		</location>
		<init ref="id16"/>
		<transition id="id22">
			<source ref="id20"/>
			<target ref="id21"/>
			<label kind="synchronisation" x="518" y="144">release1?</label>
		</transition>
		<transition id="id23">
			<source ref="id21"/>
			<target ref="id16"/>
			<label kind="synchronisation" x="280" y="204">release1?</label>
			<nail x="297" y="187"/>
			<nail x="212" y="229"/>
			<nail x="42" y="178"/>
		</transition>
		<transition id="id24">
			<source ref="id19"/>
			<target ref="id20"/>
			<label kind="synchronisation" x="552" y="51">release1?</label>
		</transition>
		<transition id="id25">
			<source ref="id18"/>
			<target ref="id19"/>
			<label kind="guard" x="476" y="-76">B == 1</label>
			<label kind="synchronisation" x="459" y="-51">take?</label>
		</transition>
		<transition id="id26">
			<source ref="id18"/>
			<target ref="id17"/>
			<label kind="guard" x="374" y="17">B == 0</label>
		</transition>
		<transition id="id27">
			<source ref="id15"/>
			<target ref="id18"/>
			<label kind="synchronisation" x="246" y="-51">take?</label>
		</transition>
		<transition id="id28">
			<source ref="id16"/>
			<target ref="id15"/>
			<label kind="synchronisation" x="68" y="34">take?</label>
		</transition>
		<transition id="id29">
			<source ref="id15"/>
			<target ref="id14"/>
			<label kind="guard" x="221" y="42">B == 0</label>
		</transition>
		<transition id="id30">
			<source ref="id14"/>
			<target ref="id16"/>
			<label kind="synchronisation" x="85" y="136">release0?</label>
			<label kind="assignment" x="85" y="93">L = 1 - L</label>
		</transition>
		<transition id="id31">
			<source ref="id17"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="280" y="110">release0?</label>
		</transition>
	</template>
	<system>const int fastest = 5;
const int fast    = 10;
const int slow    = 20;
const int slowest1 = 25;
const int slowest2 = 10;
Viking1 = Soldier(fastest);
Viking2 = Soldier(fast);
Viking3 = Soldier(slow);
Viking4 = Soldier(slowest1);
Viking5 = Soldier(slowest2);

system Viking1, Viking2, Viking3, Viking4, Viking5,  Torch;</system>
	<queries>
		<option key="--diagnostic" value="0"/>
		<query>
			<formula>E&lt;&gt; Viking1.valley</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-03-14 16:43:32 -0400">
			</result>
		</query>
		<query>
			<formula>A[] not deadlock
			</formula>
			<comment>The system is deadlock free.
			</comment>
			<result outcome="success" type="quality" timestamp="2026-03-14 00:05:49 -0400">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Viking1.safe
			</formula>
			<comment>Viking 1 can cross the bridge.
			</comment>
			<result outcome="success" type="quality" timestamp="2026-03-14 16:32:33 -0400">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Viking2.safe
			</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-03-14 00:05:56 -0400">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Viking3.safe
			</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-03-14 00:05:58 -0400">
			</result>
		</query>
		<query>
			<formula>A[] not (Viking4.safe and time&lt;slowest)
			</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-03-14 00:05:59 -0400">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Viking4.safe imply time&gt;=slowest
			</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-03-14 00:06:01 -0400">
			</result>
		</query>
		<query>
			<formula/>
			<comment/>
		</query>
		<query>
			<formula>E&lt;&gt; Viking1.safe &amp;&amp; Viking2.safe &amp;&amp; Viking3.safe &amp;&amp; Viking4.safe &amp;&amp; Viking5.safe &amp;&amp; time &lt;= 45
</formula>
			<comment>Scheduling problem reformulated as reachability formula. Use
'Diagnostic Trace:Fastest' option to find fastest solution.
			</comment>
			<result outcome="success" type="quality" timestamp="2026-03-25 12:55:24 -0400">
				<option key="--diagnostic" value="0"/>
			</result>
		</query>
	</queries>
</nta>
