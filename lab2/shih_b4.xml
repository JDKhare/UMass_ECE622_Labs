		</location>
		<location id="id13" x="-34" y="34">
			<name x="-59" y="51">crossing</name>
			<label kind="invariant" x="-102" y="85">x&lt;= pedcrosstime</label>
		</location>
		<init ref="id11"/>
		<transition id="id14">
			<source ref="id13"/>
			<target ref="id11"/>
			<label kind="guard" x="-272" y="-42">x&gt;=pedcrosstime</label>
			<label kind="assignment" x="-229" y="-17">x:=0</label>
