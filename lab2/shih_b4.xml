		</transition>
		<transition id="id8">
			<source ref="id1"/>
			<target ref="id4"/>
			<label kind="guard" x="-42" y="-93">x&gt;=60</label>
			<label kind="synchronisation" x="-42" y="-76">pedbutton?</label>
			<label kind="assignment" x="-34" y="-59">x:=0</label>
