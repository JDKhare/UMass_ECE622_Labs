			<target ref="id3"/>
			<label kind="synchronisation" x="-42" y="34">sigY!</label>
		</transition>
		<transition id="id6">
			<source ref="id3"/>
			<target ref="id0"/>
			<label kind="guard" x="-195" y="59">x&gt;=5</label>
			<label kind="synchronisation" x="-195" y="85">sigR!</label>
			<label kind="assignment" x="-195" y="102">x:=0</label>
		</transition>
		<transition id="id7">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="68" y="51">x&gt;=60</label>
			<label kind="synchronisation" x="68" y="68">sigY!</label>
