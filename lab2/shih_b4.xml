	<system>// Place template instantiations here.

trafficlightcontroller1=trafficlightcontroller();
//pedbuttom1=pedbuttom();
crosswalklight1=crosswalklight();
//receiverR=receiver(sigR);
receiverG=receiver(sigG);
receiverY=receiver(sigY);
receiverpedR=receiver(pedR);
//receiverpedG=receiver(pedG);
pedestrain1=pedestrain(60);
// List one or more processes to be composed into a system.
system trafficlightcontroller1,pedestrain1 ,crosswalklight1 ,receiverG, receiverY, receiverpedR  ;
</system>
