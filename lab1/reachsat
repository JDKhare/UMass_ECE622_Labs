#!/bin/bash
# reachsat: Unified interface for SAT-based reachability analysis

usage() {
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Modes (choose one):"
    echo "  --check          Run reachability for a specific target and depth"
    echo "  --sweep          Sweep depths from 1 to <depth> for a target"
    echo "  --find           Find all reachable states at <depth> for <bits>"
    echo ""
    echo "Parameters:"
    echo "  -v, --verilog <file>    Verilog input file (required)"
    echo "  -t, --target <bits>     Target state bitstring (for --check and --sweep)"
    echo "  -i, --init <bits>       Initial state bitstring (default: all zeros)"
    echo "  -d, --depth <k>         Unroll depth or max depth (required)"
    echo "  -b, --bits <n>          Number of state bits (for --find)"
    echo "  -s, --solver <name>     Solver to use: 'minisat' or 'picosat' (default: minisat)"
    echo "  --verbose               Show verbose solver output and timing"
    echo "  -l, --logdir <dir>      Directory for logs, dimacs, and nodes (default: current dir)"
    echo ""
    echo "Examples:"
    echo "  $0 --check -v top.v -t 1010 -d 5 -s picosat --verbose -l ./logs"
    echo "  $0 --sweep -v top.v -t 1011 -d 20 -s minisat"
    echo "  $0 --find  -v top.v -b 4 -d 15 -s picosat"
    exit 1
}

MODE=""
VFILE=""
TARGET=""
INIT=""
DEPTH=""
BITS=""
SOLVER="minisat"
VERBOSE=0
LOGDIR="."

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --check) MODE="check"; shift ;;
        --sweep) MODE="sweep"; shift ;;
        --find)  MODE="find"; shift ;;
        -v|--verilog) VFILE="$2"; shift 2 ;;
        -t|--target) TARGET="$2"; shift 2 ;;
        -i|--init) INIT="$2"; shift 2 ;;
        -d|--depth) DEPTH="$2"; shift 2 ;;
        -b|--bits) BITS="$2"; shift 2 ;;
        -s|--solver) SOLVER="$2"; shift 2 ;;
        --verbose) VERBOSE=1; shift ;;
        -l|--logdir) LOGDIR="$2"; shift 2 ;;
        -h|--help) usage ;;
        *) echo "Unknown parameter: $1"; usage ;;
    esac
done

if [ -z "$MODE" ]; then echo "Error: Mode required (--check, --sweep, --find)"; usage; fi
if [ ! -f "$VFILE" ]; then echo "Error: Verilog file '$VFILE' not found"; exit 1; fi
if [ -z "$DEPTH" ]; then echo "Error: Depth (-d) required"; exit 1; fi

mkdir -p "$LOGDIR"
V2DIMACS="$(dirname "$0")/v2dimacs"

if [ ! -x "$V2DIMACS" ]; then
    echo "Compiling v2dimacs.cpp..."
    g++ -std=c++11 -O2 "$(dirname "$0")/v2dimacs.cpp" -o "$V2DIMACS"
    if [ $? -ne 0 ]; then echo "Failed to compile v2dimacs."; exit 1; fi
fi

run_check() {
    local c_target=$1
    local c_depth=$2
    local vname=$(basename "$VFILE" .v)
    local l_prefix="${LOGDIR}/${vname}_${SOLVER}_reach_${c_target}_d${c_depth}"
    
    local c_init="$INIT"
    if [ -z "$c_init" ]; then
        # Create all zeros of same length as target
        c_init=$(printf '0%.0s' $(seq 1 ${#c_target}))
    fi

    local dimacs_f="${l_prefix}.dimacs"
    local nodes_f="${l_prefix}.nodes"
    local sat_f="${l_prefix}.sat"
    local log_f="${l_prefix}.log"
    
    # 1. Generate DIMACS
    "$V2DIMACS" "$VFILE" "$c_target" "$c_depth" "$c_init" "$dimacs_f" "$nodes_f" > "$log_f" 2>&1
    if [ $? -ne 0 ]; then
        echo "Error: DIMACS generation failed. See $log_f"
        return 1
    fi
    
    # 2. Run solver
    if [ "$SOLVER" = "picosat" ]; then
        if [ $VERBOSE -eq 1 ]; then
            echo "Running picosat on $dimacs_f ..."
            picosat -v "$dimacs_f" > "$sat_f" 2>&1
            # Save the verbose output to the log file as well
            cat "$sat_f" | tee -a "$log_f"
        else
            picosat -v "$dimacs_f" > "$sat_f" 2>/dev/null
        fi
    elif [ "$SOLVER" = "minisat" ]; then
        if [ $VERBOSE -eq 1 ]; then
            echo "Running minisat on $dimacs_f ..."
            minisat "$dimacs_f" "$sat_f" 2>&1 | tee -a "$log_f"
        else
            minisat "$dimacs_f" "$sat_f" > /dev/null 2>&1
        fi
    else
        echo "Error: Unknown solver $SOLVER"
        return 1
    fi

    # 3. Parse result
    local is_sat=0
    if grep -q "^SAT" "$sat_f" || grep -q "^s SATISFIABLE" "$sat_f"; then is_sat=1; fi
    
    if grep -q "^UNSAT" "$sat_f" || grep -q "^s UNSATISFIABLE" "$sat_f"; then is_sat=0; fi

    if [ $is_sat -eq 1 ]; then
        echo -e "SAT   \t| Target: $c_target \t| Depth: $c_depth"
        return 0
    else
        echo -e "UNSAT \t| Target: $c_target \t| Depth: $c_depth"
        return 1
    fi
}

case $MODE in
    check)
        if [ -z "$TARGET" ]; then echo "Error: Target (-t) required for check"; exit 1; fi
        run_check "$TARGET" "$DEPTH"
        ;;
    sweep)
        if [ -z "$TARGET" ]; then echo "Error: Target (-t) required for sweep"; exit 1; fi
        echo "Sweeping transitions 1 to $DEPTH for target state $TARGET using $SOLVER..."
        for ((i=1; i<=DEPTH; i++)); do
            run_check "$TARGET" "$i"
        done
        ;;
    find)
        if [ -z "$BITS" ]; then echo "Error: State bits (-b) required for find"; exit 1; fi
        MAX=$(( (1 << BITS) - 1 ))
        echo "Checking all $BITS-bit states at transition $DEPTH using $SOLVER..."
        for ((i=0; i<=MAX; i++)); do
            BIN_STR=$(bc <<< "obase=2; $i")
            BIN_STR=$(printf "%0${BITS}d\n" "$BIN_STR")
            
            # For find, we need an initial state of the right length
            if [ -z "$INIT" ]; then
                INIT=$(printf '0%.0s' $(seq 1 $BITS))
            fi
            
            # Only output if SAT
            run_check "$BIN_STR" "$DEPTH" | grep -v "UNSAT"
        done
        ;;
esac
